      ]
    },
    {
      "entity": "DetailedEvaluationItem",
      "source": "<curso>/evaluation/tda-ce-estudiante/tda-index",
      "fields": [
        "assign_id",
        "category_name",
        "name (unquoted .assignNameText)",
        "weight_pct",
        "earned_pct",
        "raw_grade_100 (Nota obtenida or earned/weight*100)",
        "is_graded",
        "description",
        "teacher_comment",
        "due_date_text",
        "due_date_iso",
        "allow_late_submission",
        "can_upload",
        "has_rubric",
        "rubric_id",
        "task_id",
        "task_item_id",
        "community_id",
        "grade_id",
        "submitted_files",
        "attachment_url",
        "solution_url",
        "feedback_url",
        "student_id (RAM-only, NEVER persisted)"
      ]
    },
    {
      "entity": "RubricBreakdown",
      "source": "POST /tda-rubrica/tda_evaluacion_rubrica (accion=ver)",
      "fields": [
        "rubric_id",
        "title",
        "evaluated_target",
        "total_score (calculate_score)",
        "max_score",
        "max_level_points",
        "is_graded",
        "criteria[{category_name, weight_pct, earned_weight_pct, earned_points, max_points, comment (tr[comment]), levels[{label, points, description, achieved (td.criterion_selected)}]}]"
      ]
    },
    {
      "entity": "ExpedienteSummary",
      "source": "/tda-expediente-estudiantil/ajax/* + GraphQL getStudentAcademicHistory",
      "fields": [
        "active_schedule_period",
        "stats (20 metrics, 8 official TEC states)",
        "grades (merged 9-col detalle_notas + 44-row GraphQL history)",
        "weighted_averages (12+ periods)",
        "citas_matricula (<tr>-less HTML parser)",
        "personal_info",
        "dar_sync_preview",
        "graduate_attributes",
        "sedes_combo",
        "periodos_combo"
      ]
    },
    {
      "entity": "WeeklyScheduleCell",
      "source": "POST /tda-expediente-estudiantil/ajax/tabla_horario (4-part '-----' payload)",
      "fields": [
        "day_index_0_mon",
        "start_minute",
        "end_minute",
        "time_range",
        "course_code",
        "course_name",
        "group",
        "professor",
        "building",
        "room",
        "credits"
      ]
    },
    {
      "entity": "GlobalHorariosIndex",
      "source": "https://tec-appsext.itcr.ac.cr/guiahorarios/ (90+ schools, 5 campuses)",
      "fields": [
        "year",
        "totalSchoolsFetched",
        "uniqueCoursesCount",
        "campuses",
        "schools",
        "careers",
        "periods",
        "modalities",
        "entries[{courseCode, courseName, group, campus, school, professor, modality, period, sessions, seatsAvailable}]"
      ]
    },
    {
      "entity": "FolderWalkResult / FileRecord",
      "source": "GET /dotlrn/file-storage/api/folder/{id}",
      "fields": [
        "root_folder_id (from $rootScope.GL_FOLDER_ID)",
        "folders[]",
        "files[{object_id, name, mime_type, content_size, last_modified_ansi, file_url, download_url, local_path, sha256}]",
        "url_links[]"
      ]
    },
    {
      "entity": "NotificationsFeed & Subscriptions",
      "source": "/tda-notifications/ajax/* + /notifications/manage",
      "fields": [
        "unread_count",
        "notifications[{notification_id, title, text, origin, category_id, state (U|R), url, creation_date}]",
        "subscriptions[{request_id, community, notice_type, element, frequency}]"
      ]
    },
    {
      "entity": "UserModelSnapshot",
      "source": "POST /tda-um/ajax/get_info (10 HTML sections)",
      "fields": [
        "consent_status",
        "dimensions[{dimension_key, title, metrics[{label, value}]}]"
      ]
    },
    {
      "entity": "PlagiarismTreeSnapshot",
      "source": "/tda-control-plagio/ajax/cargaArbol + cargaMisDocs + cargaDocsCurso + generaReporte",
      "fields": [
        "root_folder_id",
        "nodes[]",
        "documents[{doc_uid, duplicate_uid, title, course, similarity_pct, status, report_url}]"
      ]
    },
    {
      "entity": "FeriaNegociosSnapshot",
      "source": "/tda-feria-negocios/ajax/ferias/get_ferias + categorias/load_categorias",
      "fields": [
        "categories[]",
        "feria_rows[{name, start_date, end_date, bases_url}]"
      ]
    },
    {
      "entity": "PerformanceEvaluation",
