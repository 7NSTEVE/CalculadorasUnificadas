# Private local assets (installers, official Casio DLL runtime, PDF manuals, personal fonts, research)
# Note: assets/roms/ remains tracked in Git per explicit owner policy.
private_local/

# Uncompressed warm-state duplicate (cg50_warm_state.bin.gz is tracked instead) and ad-hoc dumps
assets/roms/cg50_warm_state.bin
tests/**/warm_state.bin
*.g3a
*.g3m
*.mem
*Manager PLUS*

