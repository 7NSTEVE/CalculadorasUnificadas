{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CG50 Features Master Inventory",
  "type": "object",
  "required": ["schema_version", "generated_at", "repo_commit", "sources", "summary", "features"],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "repo_commit": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "object" } },
    "summary": {
      "type": "object",
      "required": ["total_unique_features", "total_menu_routes", "areas_count", "casio_2900_methodology_documented"],
      "properties": {
        "total_unique_features": { "type": "integer", "minimum": 1 },
        "total_menu_routes": { "type": "integer", "minimum": 0 },
        "areas_count": { "type": "integer", "minimum": 1 },
        "casio_2900_methodology_documented": { "type": "boolean" }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "feature", "area", "kind", "source", "menu_paths",
          "restrictions", "dependencies", "implemented",
          "test_cases_target", "test_cases_executed", "test_cases_passed",
          "physical_reference_verified", "official_emulator_verified",
          "host_math_fallback_allowed", "status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^CG50-[A-Z0-9-]+-[0-9]{3,4}$" },
          "feature": { "type": "string" },
          "area": { "type": "string" },
          "kind": { "enum": ["command", "function", "template", "operator", "app_mode", "setting", "programming", "python_api", "addin_feature", "system"] },
          "source": {
            "type": "object",
            "required": ["document", "chapter", "section", "page_en"],
            "properties": {
              "document": { "type": "string" },
              "chapter": { "type": ["integer", "string"] },
              "section": { "type": "string" },
              "page_en": { "type": ["integer", "string"] },
              "page_es": { "type": ["integer", "string", "null"] }
            }
          },
          "menu_paths": { "type": "array", "items": { "type": "string" } },
          "rom_symbol_confirmed": { "type": "boolean" },
          "restrictions": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "implemented": { "type": "boolean" },
          "test_cases_target": { "type": "integer", "minimum": 1 },
          "test_cases_executed": { "type": "integer", "minimum": 0 },
          "test_cases_passed": { "type": "integer", "minimum": 0 },
          "existing_case_ids": { "type": "array", "items": { "type": "string" } },
          "physical_reference_verified": { "type": "boolean" },
          "official_emulator_verified": { "type": "boolean" },
          "host_math_fallback_allowed": { "const": false },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED", "NOT_APPLICABLE"] }
        }
      }
    }
  }
}
